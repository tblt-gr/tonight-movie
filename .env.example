# Server-only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
# TMDB v4 "API Read Access Token" (not the v3 key): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Number of trusted reverse proxies in front of the app, used to read the client IP
# from X-Forwarded-For for rate limiting. 0 ignores the header (one shared bucket).
TRUSTED_PROXY_HOPS=1
