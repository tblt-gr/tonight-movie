  "narrative": {
    "northStar": "La séance personnelle",
    "overview": "Tonight’s Movie donne aux films la place principale sur un fond bleu nuit. Le crème rend les textes confortables, et un vert frais signale l’action et les accès déjà inclus dans les abonnements choisis. Le titre éditorial invite à choisir un film; les contrôles compacts servent à préciser ce choix.",
    "keyCharacteristics": [
      "Bleu nuit, crème et vert séance",
      "Affiches dominantes et métadonnées compactes",
      "Statuts d’accès explicites dans le texte comme dans la couleur"
    ],
    "rules": [
      {
        "name": "Une couleur pour l’accès actuel",
        "body": "Le vert sert aux actions principales et aux films inclus dans les abonnements sélectionnés; les autres offres utilisent le bleu et l’indisponibilité l’or pâle.",
        "section": "colors"
      },
      {
        "name": "Le film d’abord",
        "body": "Les affiches restent libres dans la grille. Les surfaces encadrées sont réservées aux choix et aux réglages.",
