      },
      {
        "name": "Clavier visible",
        "body": "Chaque contrôle conserve un contour de focus clair; les statuts portent un libellé lisible sans leur couleur.",
        "section": "components"
      }
    ],
    "dos": [
      "Afficher la collection active et la date des offres.",
      "Associer icône, texte et état pour chaque plateforme.",
      "Laisser le tirage aléatoire accessible sans ouvrir ses critères."
    ],
    "donts": [
      "Présenter une location comme un abonnement inclus.",
      "Imiter le logo ou le système de trois points de Letterboxd.",
      "Faire dépendre un état uniquement de sa couleur."
